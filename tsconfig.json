{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": [
		"playwright.config.ts",
		"tests/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"apps",
		"packages"
	]
}
