{
    "$schema": "https://turborepo.com/schema.json",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                ".next/**"
            ],
            "env": [
                "NEXT_PUBLIC_*",
                "CONVEX_DEPLOYMENT"
            ]
        },
        "lint": {
            "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
            "outputs": []
        },
        "lint:fix": {
            "cache": false,
            "outputs": []
        },
        "typecheck": {
            "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
            "outputs": []
        },
        "test": {
            "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
            "outputs": []
        },
        "//#lint:root": {
            "inputs": ["eslint.config.mjs", "playwright.config.ts", "scripts/**", "tests/**", "packages/eslint-config/**"],
            "outputs": []
        },
        "//#typecheck:root": {
            "inputs": ["tsconfig.json", "playwright.config.ts", "tests/**/*.ts"],
            "outputs": []
        },
        "//#test:root": {
            "inputs": ["tests/run-e2e.test.mjs", "scripts/run-e2e.mjs"],
            "outputs": []
        }
    }
}
