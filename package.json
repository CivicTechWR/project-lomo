{
	"name": "@civictechwr/project-lomo",
	"version": "0.1.0",
	"packageManager": "bun@1.4.2",
	"description": "LoMo - a calm, consent-based platform for asking for and offering help in the community",
	"author": {
		"name": "CivicTechWR",
		"email": "noreply@civictechwr.org",
		"url": "https://civictechwr.org"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"contributors": [
		{
			"name": "CivicTechWR Community",
			"url": "https://civictechwr.org"
		}
	],
	"license": "MIT",
	"homepage": "https://github.com/CivicTechWR/project-lomo",
	"repository": {
		"type": "git",
		"url": "https://github.com/CivicTechWR/project-lomo.git"
	},
	"bugs": {
		"url": "https://github.com/CivicTechWR/project-lomo/issues"
	},
	"keywords": [
		"civic-tech",
		"sharing-economy",
		"community",
		"mutual-aid"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"actions:up": "actions-up",
		"version": "echo 'Template version:' $npm_package_version",
		"changelog": "echo 'See CHANGELOG.md for release notes'",
		"release": "echo 'Use GitHub Releases for official releases'",
		"lint": "turbo run lint lint:root",
		"lint:root": "eslint --no-warn-ignored eslint.config.mjs playwright.config.ts scripts tests",
		"lint:fix": "eslint --no-warn-ignored --fix eslint.config.mjs playwright.config.ts scripts tests && turbo run lint:fix",
		"typecheck": "turbo run typecheck typecheck:root",
		"typecheck:root": "tsc --noEmit",
		"test": "turbo run test test:root",
		"test:root": "bun test tests/run-e2e.test.mjs",
		"test:e2e": "bun scripts/run-e2e.mjs",
		"build": "turbo run build",
		"setup": "bun scripts/setup.ts",
		"dev": "turbo run dev --ui=tui",
		"prepare": "lefthook install"
	},
	"civictechwr": {
		"template_version": "1.0.0",
		"season_lifecycle": "12-weeks",
		"last_updated": "2025-09-28"
	},
	"catalog": {
		"zod": "4.6.7",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"typescript": "7.0.2",
		"eslint": "10.13.0",
		"tailwindcss": "4.3.3",
		"@tailwindcss/vite": "4.3.3",
		"vite": "8.3.5",
		"convex": "1.48.0",
		"better-auth": "1.7.13",
		"@convex-dev/better-auth": "^0.12.5",
		"@antfu/eslint-config": "10.0.0",
		"@eslint-react/eslint-plugin": "5.28.8",
		"eslint-plugin-react-hooks": "7.1.1",
		"vitest": "5.0.5",
		"@vitejs/plugin-react": "6.1.2",
		"jsdom": "30.1.3",
		"@types/node": "^26.6.5",
		"libphonenumber-js": "1.13.15",
		"react-aria": "3.53.1",
		"react-aria-components": "1.22.1",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1"
	},
	"dependencies": {
		"@zxcvbn-ts/core": "^4.2.0",
		"@zxcvbn-ts/language-common": "^4.1.3",
		"@zxcvbn-ts/language-en": "^4.1.1"
	},
	"devDependencies": {
		"@playwright/cli": "^0.1.22",
		"@playwright/test": "^1.64.1",
		"@types/node": "catalog:",
		"actions-up": "2.0.0",
		"eslint": "catalog:",
		"lefthook": "^2.2.2",
		"playwright": "^1.64.1",
		"turbo": "^2.11.10",
		"typescript": "catalog:"
	}
}
