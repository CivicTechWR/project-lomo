{
	"name": "@civictechwr/project-lomo",
	"version": "0.1.0",
	"description": "LoMo - a calm, consent-based platform for asking for and offering help in the community",
	"author": {
		"name": "CivicTechWR",
		"email": "noreply@civictechwr.org",
		"url": "https://civictechwr.org"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"contributors": [
		{
			"name": "CivicTechWR Community",
			"url": "https://civictechwr.org"
		}
	],
	"packageManager": "bun@1.3.8",
	"license": "MIT",
	"homepage": "https://github.com/CivicTechWR/project-lomo",
	"repository": {
		"type": "git",
		"url": "https://github.com/CivicTechWR/project-lomo.git"
	},
	"bugs": {
		"url": "https://github.com/CivicTechWR/project-lomo/issues"
	},
	"keywords": [
		"civic-tech",
		"sharing-economy",
		"community",
		"mutual-aid"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
    	"actions:up": "actions-up",
    	"version": "echo 'Template version:' $npm_package_version",
    	"changelog": "echo 'See CHANGELOG.md for release notes'",
    	"release": "echo 'Use GitHub Releases for official releases'",
    	"lint": "turbo run lint",
    	"lint:fix": "turbo run lint:fix",
    	"typecheck": "turbo run typecheck",
    	"test": "turbo run test",
    	"build": "turbo run build",
    	"dev": "turbo run dev --ui=tui",
    	"prepare": "lefthook install"
	},
	"civictechwr": {
		"template_version": "1.0.0",
		"season_lifecycle": "12-weeks",
		"last_updated": "2025-09-28"
	},
	"catalog": {
		"zod": "4.3.6",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"typescript": "5.9.3",
		"eslint": "10.1.0",
		"tailwindcss": "4.2.2",
		"@tailwindcss/vite": "4.2.2",
		"vite": "7.3.1",
		"convex": "1.45.0",
		"better-auth": "1.6.22",
		"@convex-dev/better-auth": "^0.12.5",
		"@antfu/eslint-config": "7.7.0",
		"@eslint-react/eslint-plugin": "2.13.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"vitest": "3.2.6",
		"@vitejs/plugin-react": "5.1.4",
		"jsdom": "30.0.1",
		"@types/node": "^26.4.0",
		"react-aria": "3.51.0",
		"react-aria-components": "1.20.0",
		"tailwind-merge": "3.5.0",
		"tailwind-variants": "3.3.1"
	},
	"devDependencies": {
		"actions-up": "1.20.0",
		"eslint": "catalog:",
		"lefthook": "^2.1.14",
		"turbo": "^2.11.2"
	},
	"dependencies": {
		"@zxcvbn-ts/core": "^4.2.0",
		"@zxcvbn-ts/language-common": "^4.1.3",
		"@zxcvbn-ts/language-en": "^4.1.1"
	}
