# Copy to .env.local and fill in. Convex CLI loads .env.local when you run `convex dev`.

CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Required by convex/lib/siteEnv.ts — public origin of the Next.js app (Better Auth baseURL).
# Local: http://localhost:3000
# Production: set this on the Convex *production* deployment to your live https:// origin
# (must match the browser URL and the host’s NEXT_PUBLIC_SITE_URL).
SITE_URL=http://localhost:3000

# Optional comma-separated extra origins (preview deploys, etc.). SITE_URL is always trusted.
# TRUSTED_ORIGINS=https://your-preview.vercel.app

# --- Email (Resend) — set in Convex dashboard for prod, or below for `convex dev` ---
# Used for notifications, password reset, and (with EMAIL_RELAY_DOMAIN) masked relay.
# RESEND_API_KEY=re_...
# NOTIFICATIONS_FROM_EMAIL="LoMo <notifications@yourdomain.com>"

# Masked relay: subdomain receiving inbound mail (configure MX in DNS per Resend inbound docs).
# EMAIL_RELAY_DOMAIN=reply.yourdomain.com

# Webhook signing secret from Resend → Webhooks → your endpoint (starts with whsec_).
# Point the webhook URL at: https://<deployment>.convex.site/webhooks/resend-inbound
# Events: email.received
# RESEND_WEBHOOK_SECRET=whsec_...
