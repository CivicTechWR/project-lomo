# Copy this file to .env.local and fill in your values.
# Run: cp apps/lomoweb/.env.local.example apps/lomoweb/.env.local

# Convex deployment identifier — set automatically by `bunx convex dev`
# Format: anonymous:<project-name>
CONVEX_DEPLOYMENT=anonymous:anonymous-convex-backend

# Convex HTTP API URL (local dev default)
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Convex site URL — same host as above but port 3211
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Local dev site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
